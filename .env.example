# Bootstrap defaults. Authenticated GUI changes are stored in config/settings.json
# and override these values.
# Keelhaularr login
APP_USERNAME=captain
APP_PASSWORD=choose-a-password
APP_SESSION_SECRET=replace-with-a-different-long-random-string
APP_SESSION_DAYS=30
# Set true only when the site is served over HTTPS.
APP_COOKIE_SECURE=false

# Informational list shown in GUI Settings. These paths must also be mounted
# into the container in compose.yml.
STORAGE_ROOTS=/movies,/tv,/radarr-downloads,/sonarr-downloads,/quarantine

# Shared defaults. Per-app overrides are available below.
MAX_MB_PER_MIN=85
OVERSIZE_TOLERANCE_GIB=1

# Radarr API and library access
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
RADARR_MEDIA_ROOTS=/movies
# Optional completed download/torrent folders for hardlink integrity checks.
RADARR_DOWNLOAD_ROOTS=/radarr-downloads
# Only needed if Radarr reports a different path from the one visible to Keelhaularr.
# Multiple mappings are separated by semicolons.
RADARR_PATH_MAPS=
# RADARR_PATH_MAPS=/data/movies=>/movies;/archive/movies=>/archive-movies
# RADARR_MAX_MB_PER_MIN=85
# RADARR_OVERSIZE_TOLERANCE_GIB=1
RADARR_INCLUDE_UNMONITORED=false
RADARR_USE_ARR_QUALITY_DEFINITIONS=false

# Sonarr API and library access
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
SONARR_MEDIA_ROOTS=/tv
SONARR_DOWNLOAD_ROOTS=/sonarr-downloads
SONARR_PATH_MAPS=
# SONARR_PATH_MAPS=/data/tv=>/tv
# SONARR_MAX_MB_PER_MIN=85
# SONARR_OVERSIZE_TOLERANCE_GIB=1
SONARR_INCLUDE_UNMONITORED=false
SONARR_USE_ARR_QUALITY_DEFINITIONS=false

# Optional qBittorrent Web UI safety connection. Incomplete torrents are
# withheld from completed-download orphan results.
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
QBITTORRENT_PATH_MAPS=
# QBITTORRENT_URL=http://qbittorrent:8080
# QBITTORRENT_PATH_MAPS=/downloads/movies=>/radarr-downloads;/downloads/tv=>/sonarr-downloads

# Automatic qBittorrent recovery is opt-in and stays disabled until both
# qBittorrent and at least one Arr app are configured. A speed of 0 disables
# slow-speed detection. Categories are exact JSON strings; "" is Uncategorized.
QBITTORRENT_RECOVERY_ENABLED=false
QBITTORRENT_RECOVERY_SLOW_KIB_PER_SECOND=100
QBITTORRENT_RECOVERY_SLOW_MINUTES=30
QBITTORRENT_RECOVERY_STALLED_MINUTES=30
QBITTORRENT_RECOVERY_EXCLUDED_CATEGORIES_JSON=[]

# Recoverable quarantine destination for untracked-file actions.
ORPHAN_TRASH_DIR=/quarantine

# Optional orphan scanner controls
ORPHAN_IGNORE_DIRECTORIES=extras,featurettes,trailers,samples
ORPHAN_MAX_FILES=100000
# Ignore an unlinked completed download until it has been untouched this long.
HARDLINK_MIN_AGE_HOURS=24
QUARANTINE_RETENTION_DAYS=0
# Refuse to remove an oversized file unless Radarr/Sonarr can currently offer a
# release that fits the size limit and is smaller than the file being replaced.
# Uses interactive search, so jobs take longer while indexers are queried.
OVERSIZE_REQUIRE_REPLACEMENT=false

# Optional watch guard. Withholds any file played within the window, and anything
# playing right now, from every file action. Both a URL and a token are required;
# leave the URL blank to disable. Fails closed: a configured server that cannot be
# reached preserves files rather than removing them.
MEDIA_SERVER_TYPE=jellyfin
MEDIA_SERVER_URL=
MEDIA_SERVER_TOKEN=
MEDIA_SERVER_WATCHED_WITHIN_DAYS=30
# MEDIA_SERVER_PATH_MAPS=/media/movies=>/movies;/media/tv=>/tv
SCHEDULE_ENABLED=false
SCHEDULE_INTERVAL_HOURS=24
NOTIFICATION_TYPE=generic
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WHEN_CLEAR=false
# MEDIA_EXTENSIONS=mkv,mp4,avi,m4v,mov,ts,m2ts,wmv,webm,mpg,mpeg,iso

PORT=8787
